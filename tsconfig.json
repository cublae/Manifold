{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],

    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    // `node_modules/ags` is a symlink into the Nix store. Without this,
    // TypeScript resolves it to the real path for some imports and the link for
    // others, and the same class ends up with two identities -- which is how
    // `Process` came to be "not assignable to type Process".
    "preserveSymlinks": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,

    "experimentalDecorators": false,

    "jsx": "react-jsx",
    "jsxImportSource": "ags/gtk4",

    "baseUrl": ".",
    "paths": {
      "ags": ["./node_modules/ags/lib/index.ts"],
      "ags/*": ["./node_modules/ags/lib/*"],
      "gnim": ["./node_modules/ags/node_modules/gnim/dist/index.ts"],
      "gnim/*": ["./node_modules/ags/node_modules/gnim/dist/*"]
    }
  },
  // `@girs` is generated by `ags types -d .` and holds the `gi://*` module
  // declarations plus the GJS globals (console, TextDecoder). Without it every
  // import of a system library is an error and the real ones drown.
  "include": ["src/**/*", "env.d.ts", "@girs/*.d.ts"]
}
